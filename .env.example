# Copia este archivo a .env. En la nube basta con definir DATABASE_URL (tiene prioridad).
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

POSTGRES_USER=velocista
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=velocista
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432

DEVICE_TOKEN_ROBOT=dev-token-robot
DEVICE_TOKEN_TIMER=dev-token-timer
SIMULATION_SERVICE_TOKEN=dev-simulation-service-token

# Producción: APP_ENV=production, AUTH_REQUIRED=true y secretos configurados.
AUTH_REQUIRED=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SECRET_KEY=change-me
TOKEN_EXPIRE_MINUTES=60

# External simulator (one process / one worker). Apply alembic upgrade head first.
SIM_ENABLED=false
SIM_WS_URL=wss://velocista-sim-production.up.railway.app/ws
# Optional external selection. Omit to use the server defaults.
# SIM_ROBOT_ID=velocista-01
# SIM_TRACK_ID=oval-01
# Required to start a run: IDs already registered in this backend.
# SIM_INTERNAL_ROBOT_ID=...
# SIM_SETUP_ID=1
# SIM_PROFILE_ID=club
SIM_STORE_TELEMETRY=true
SIM_QUEUE_SIZE=5000
SIM_COMMAND_TIMEOUT=10
SIM_RECONNECT_MAX_SECONDS=30
